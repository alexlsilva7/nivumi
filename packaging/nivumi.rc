#pragma code_page(65001)
#include <windows.h>
1 ICON "@APP_ICON@"
2 ICON "@TRAY_ICON@"
1 VERSIONINFO
 FILEVERSION @VERSION_COMMA@
 PRODUCTVERSION @VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Nivumi"
   VALUE "FileVersion", "@VERSION@"
   VALUE "InternalName", "nivumi"
   VALUE "OriginalFilename", "nivumi.exe"
   VALUE "ProductName", "Nivumi"
   VALUE "ProductVersion", "@VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
